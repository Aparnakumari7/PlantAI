{
  "services": [
    {
      "type": "web",
      "name": "drplant-ai-backend",
      "env": "node",
      "plan": "free",
      "region": "ohio",
      "buildCommand": "npm install",
      "startCommand": "npm run start:prod",
      "envVars": [
        {
          "key": "NODE_ENV",
          "value": "production"
        },
        {
          "key": "FRONTEND_URL",
          "value": "https://drplant-ai.vercel.app"
        },
        {
          "key": "JWT_SECRET",
          "generateValue": true
        },
        {
          "key": "DATABASE_URL",
          "fromDatabase": {
            "name": "drplant-db",
            "property": "connectionString"
          }
        }
      ],
      "repo": "https://github.com/Aparnakumari7/PlantAI.git"
    }
  ],
  "databases": [
    {
      "name": "drplant-db",
      "databaseName": "drplant",
      "user": "drplant_user",
      "plan": "free",
      "region": "ohio",
      "postgresMajorVersion": "15"
    }
  ]
}
